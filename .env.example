# ==============================================================================
# VITBMUN IPL MEGA AUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Mode: "mock" (default, local storage & cross-tab BroadcastChannel) or "firebase"
NEXT_PUBLIC_AUCTION_BACKEND=mock

# Unique Tournament Event Identifier
NEXT_PUBLIC_AUCTION_EVENT_ID=event-2026

# Admin & Auctioneer Access Passcodes (comma-separated list for custom event security)
# If left unset, defaults to: admin2026, vitb-ipl-admin, auctioneer2026
NEXT_PUBLIC_ADMIN_PASSCODES=admin2026,vitb-ipl-admin,auctioneer2026

# ==============================================================================
# FIREBASE CONFIGURATION (Required only when NEXT_PUBLIC_AUCTION_BACKEND=firebase)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
